# ==============================================================
# DirectPG Frontend (Next.js) - Environment Configuration
# ==============================================================

# Application Branding
NEXT_PUBLIC_APP_NAME=DirectPG
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --------------------------------------------------------------
# Backend API (Render Deployment)
# Replace with your deployed Render service URL:
# e.g., https://directpg-backend.onrender.com/api
# --------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=https://directpg-backend.onrender.com/api

# --------------------------------------------------------------
# Supabase Client (For direct client reads / image assets)
# --------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://aflojrxieijtlqhugpon.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --------------------------------------------------------------
# Optional 3rd Party Integrations
# --------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
