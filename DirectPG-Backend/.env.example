# DirectPG Backend Environment Configuration
# Copy this file to .env for local testing

PORT=5000
NODE_ENV=production

# Client Application URL (For CORS allow-list)
FRONTEND_URL=http://localhost:3000,https://direct-pg.vercel.app

# -------------------------------------------------------------
# 1. MONGODB ATLAS: Authentication, Security & KYC Credentials
# -------------------------------------------------------------
# Used exclusively for:
# - User authentication (Tenants, Owners, Admins)
# - Bcrypt password hashes
# - Sensitive KYC/Aadhaar/PAN verification records & audit logs
# Get your free URI at https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/directpg_auth?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_SECRET=directpg_super_secret_jwt_key_replace_in_production_2026
JWT_REFRESH_SECRET=directpg_super_refresh_jwt_key_replace_in_production_2026
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# -------------------------------------------------------------
# 2. SUPABASE: Core Relational Properties, Bookings & Reviews
# -------------------------------------------------------------
# Used exclusively for:
# - PG properties & room inventories
# - Tenant booking records & payment transactions
# - Walkthrough visits & verified reviews
# Get your credentials at https://supabase.com
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
